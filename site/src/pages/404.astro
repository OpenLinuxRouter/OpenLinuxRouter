---
import BaseLayout from '../layouts/BaseLayout.astro'
import { href } from '../lib/i18n'

const lang = 'en'
---

<BaseLayout lang={lang} title="Page not found" description="That page does not exist." path="/404" noIndex>
  <section class="shell flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="mt-4 max-w-md text-sm leading-relaxed text-muted-foreground">
      The address does not match a page on this site. The console has a page for almost everything;
      this is not one of them.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5">
      <a href="/" class="rounded-lg bg-primary-fill px-4 py-2 text-sm font-medium text-primary-foreground">Home</a>
      <a href={href(lang, '/gallery')} class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium">Gallery</a>
      <a href={href(lang, '/docs')} class="rounded-lg border border-border bg-card px-4 py-2 text-sm font-medium">Documentation</a>
      <a href="/zh/" class="rounded-lg px-4 py-2 text-sm text-muted-foreground">中文</a>
    </div>
  </section>
</BaseLayout>
