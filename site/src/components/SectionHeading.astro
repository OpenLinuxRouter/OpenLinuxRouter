---
// Section heading with an optional eyebrow and trailing link.
import type { Lang } from '../lib/i18n'

interface Props {
  lang: Lang
  eyebrow?: string
  title: string
  lead?: string
  link?: { href: string; label: string }
}

const { lang, eyebrow, title, lead, link } = Astro.props
---

<div class="flex flex-wrap items-end justify-between gap-4">
  <div class="max-w-2xl">
    {eyebrow && <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{eyebrow}</p>}
    <h2 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
    {lead && <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted-foreground">{lead}</p>}
  </div>
  {
    link && (
      <a href={link.href} class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-primary">
        {link.label}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3.5 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    )
  }
</div>
