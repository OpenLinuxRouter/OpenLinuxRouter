---
import CapabilityGrid from '../components/CapabilityGrid.astro'
import { capabilities, install } from '../lib/content'
import type { Lang } from '../lib/i18n'
import { href, site, t } from '../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const copy = t(lang)

const text = {
  en: {
    eyebrow: 'Capabilities',
    title: 'What it does, module by module',
    lead: 'Every module owns one piece of the network, renders it into the daemon that implements it, and says what it needs before you turn it on.',
    note: 'QoS can store policy but does not shape traffic yet. Wi-Fi, bridges, VLANs, PPPoE and multi-WAN are not implemented. Interfaces must be handed to olr explicitly.',
    noteTitle: 'What is not there yet',
  },
  zh: {
    eyebrow: '能力',
    title: '它做什么，一个模块一个模块说',
    lead: '每个模块管网络的一小块，把配置渲染给真正实现它的守护进程，并且在你要打开它之前，先说清它需要什么。',
    note: 'QoS 目前只能存策略，还不会真正限速。Wi-Fi、网桥、VLAN、PPPoE 与多 WAN 尚未实现。接口必须明确交付给 olr。',
    noteTitle: '还没有的东西',
  },
}
const s = text[lang]
---

  <section class="shell pb-4 pt-16 sm:pt-20">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{s.eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-5xl">{s.title}</h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">{s.lead}</p>
  </section>

  <section class="shell py-10">
    <CapabilityGrid lang={lang} items={capabilities} detailed />
  </section>

  <section class="shell pb-20">
    <div class="rounded-xl border border-border bg-card p-6 sm:p-8">
      <h2 class="text-sm font-semibold">{s.noteTitle}</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-muted-foreground">{s.note}</p>
    </div>
  </section>

  <section class="shell pb-20 text-center">
    <p class="text-sm text-muted-foreground">
      <span class="font-mono text-xs">{install[lang]}</span>
    </p>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-3 text-sm">
      <a href={href(lang, '/docs/install')} class="font-medium text-primary hover:underline">{copy.readDocs}</a>
      <span class="text-border" aria-hidden="true">·</span>
      <a href={site.repo} target="_blank" rel="noreferrer" class="font-medium text-primary hover:underline">GitHub</a>
    </div>
  </section>
