---
import type { Lang } from '../lib/i18n'
import { href, site, t } from '../lib/i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const copy = t(lang)
const year = new Date().getFullYear()

const columns =
  lang === 'en'
    ? [
        {
          title: 'Product',
          links: [
            { href: href(lang, '/capabilities'), label: 'Capabilities', external: false },
            { href: href(lang, '/gallery'), label: 'Gallery', external: false },
          ],
        },
        {
          title: 'Resources',
          links: [
            { href: href(lang, '/docs'), label: 'Documentation', external: false },
            { href: site.repo, label: 'GitHub', external: true },
            { href: `${site.repo}/blob/main/design.md`, label: 'Design notes', external: true },
          ],
        },
        {
          title: 'Install',
          links: [
            { href: href(lang, '/docs/install'), label: 'Install on Debian', external: false },
            { href: `${site.repo}#getting-started`, label: 'Getting started', external: true },
          ],
        },
      ]
    : [
        {
          title: '产品',
          links: [
            { href: href(lang, '/capabilities'), label: '能力', external: false },
            { href: href(lang, '/gallery'), label: '图库', external: false },
          ],
        },
        {
          title: '资源',
          links: [
            { href: href(lang, '/docs'), label: '文档', external: false },
            { href: site.repo, label: 'GitHub', external: true },
            { href: `${site.repo}/blob/main/design.md`, label: '设计说明', external: true },
          ],
        },
        {
          title: '安装',
          links: [
            { href: href(lang, '/docs/install'), label: '在 Debian 上安装', external: false },
            { href: `${site.repo}#getting-started`, label: '快速上手', external: true },
          ],
        },
      ]
---

<footer class="mt-24 border-t border-border">
  <div class="shell grid gap-10 py-12 md:grid-cols-[1.4fr_repeat(3,1fr)] md:gap-8">
    <div class="max-w-xs">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 100 100" class="size-5" aria-hidden="true">
          <path fill="#13a7f5" d="M50 8A42 42 0 0 0 50 92V69A19 19 0 0 1 50 31Z"></path>
          <path fill="#fd605e" d="M50 8A42 42 0 0 1 50 92V69A19 19 0 0 0 50 31Z"></path>
          <circle fill="#13a7f5" cx="50" cy="19.5" r="11.5"></circle>
          <circle fill="#fd605e" cx="50" cy="80.5" r="11.5"></circle>
        </svg>
        <span class="text-sm font-semibold">{site.name}</span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        {
          lang === 'en'
            ? 'Router software for personal, homelab and small-org networks. A package on an ordinary Linux box, not a system image.'
            : '为个人、家庭实验室和小型组织做的路由器软件。它只是普通 Linux 机器上的一个包，不是要刷的系统镜像。'
        }
      </p>
      <p class="mt-4 inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-2.5 py-1 text-xs text-muted-foreground">
        <span class="size-1.5 rounded-full bg-[var(--success)]" aria-hidden="true"></span>
        {copy.status}: {copy.early}
      </p>
    </div>

    {
      columns.map((column) => (
        <div>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{column.title}</h2>
          <ul class="mt-3 space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-foreground/80 transition-colors hover:text-primary"
                  {...(link.external ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-border">
    <div class="shell flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-muted-foreground">
      <p>© {year} Open Linux Router · MIT License</p>
      <p class="font-mono">{lang === 'en' ? 'Debian 13 · Ubuntu · systemd · nftables' : 'Debian 13 · Ubuntu · systemd · nftables'}</p>
    </div>
  </div>
</footer>
